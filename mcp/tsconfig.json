{
	"compilerOptions": {
		"module": "node16",
		"moduleResolution": "node16",
		"target": "es2022",
		"lib": ["es2023"],
		"outDir": "dist",
		"rootDir": "src",
		"strict": true,
		"declaration": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true
	},
	"include": ["src"]
}
