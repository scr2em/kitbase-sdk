{
	"name": "@kitbase/mcp",
	"version": "1.0.1",
	"description": "Kitbase MCP server — project analytics, AI visibility, sessions and more, for Claude and other MCP clients",
	"keywords": [
		"kitbase",
		"mcp",
		"model-context-protocol",
		"analytics",
		"claude"
	],
	"homepage": "https://github.com/scr2em/kitbase-sdk/tree/main/mcp#readme",
	"bugs": {
		"url": "https://github.com/scr2em/kitbase-sdk/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/scr2em/kitbase-sdk.git",
		"directory": "mcp"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"bin": {
		"kitbase-mcp": "./dist/stdio.js"
	},
	"files": [
		"dist"
	],
	"exports": "./dist/modules/index.js",
	"scripts": {
		"build": "npm run clean && tsc",
		"stdio": "tsx src/stdio.ts",
		"generate:types": "sh scripts/generate-types.sh",
		"generate": "npm run generate:types",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint src",
		"clean": "rm -rf dist",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.20.0",
		"openapi-fetch": "^0.13.0",
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"@types/node": "^22",
		"openapi-typescript": "^7",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0"
	},
	"engines": {
		"node": ">=20"
	}
}
