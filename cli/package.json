{
	"name": "@kitbase/cli",
	"version": "0.1.0",
	"description": "Kitbase CLI — manage your Kitbase projects from the terminal",
	"bin": {
		"kitbase": "./bin/run.js"
	},
	"files": [
		"dist",
		"bin"
	],
	"type": "module",
	"exports": "./dist/index.js",
	"scripts": {
		"build": "npm run clean && tsc && oclif manifest",
		"dev": "tsc --watch",
		"generate:types": "openapi-typescript ../../Flyway/openapi.yaml -o src/generated/api.ts",
		"generate:commands": "tsx scripts/generate-commands.ts --spec ../../Flyway/openapi.yaml",
		"generate": "npm run generate:types && npm run generate:commands",
		"lint": "oxlint src",
		"test": "vitest run",
		"clean": "rm -rf dist",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"@inquirer/prompts": "^8.3.2",
		"@oclif/core": "^4",
		"chalk": "^5.3.0",
		"dotenv": "^16.4.5",
		"open": "^10.1.0",
		"openapi-fetch": "^0.13.0",
		"ora": "^8.0.1"
	},
	"devDependencies": {
		"@types/node": "^22",
		"oclif": "^4",
		"openapi-typescript": "^7",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0",
		"vitest": "^1.2.0",
		"yaml": "^2.6.0"
	},
	"oclif": {
		"bin": "kitbase",
		"commands": "./dist/commands",
		"dirname": "kitbase",
		"topicSeparator": " "
	},
	"engines": {
		"node": ">=18"
	}
}